+class CacheCollisionTests(unittest.TestCase):
+    def fixture(self, tmp, size=4):
+        payload = Path(tmp) / "feat.npy"
+        payload.write_bytes(b"a" * size)
+        receipt = Path(tmp) / "receipt.json"
+        T.CacheLedger(receipt, T.SourceLedger()).verify_or_create([payload], {})
+        return payload, receipt
+
+    def test_dev_shm_real_collisions_rejected(self):
+        import os
+        collisions = 0
+        for _ in range(100):
+            with tempfile.TemporaryDirectory(dir="/dev/shm") as tmp:
+                payload, receipt = self.fixture(tmp)
+                old = payload.stat()
+                stamp = T.stat_identity(payload)
+                payload.write_bytes(b"bbbb")
+                os.utime(payload, ns=(old.st_atime_ns, old.st_mtime_ns))
+                collisions += stamp == T.stat_identity(payload)
+                sources = T.SourceLedger()
+                with self.assertRaisesRegex(ValueError, "invalidated"):
+                    T.CacheLedger(receipt, sources).verify_or_create([payload], {})
+                self.assertEqual(sources.files, {})
+        print(f"/dev/shm: {collisions}/100 real stat collisions; 100/100 changes rejected")
+        self.assertGreater(collisions, 0, "No real collision observed; collision coverage NOT demonstrated")
+
+    def test_small_metadata_rehashed_even_when_old_and_already_recorded(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            payload, receipt = self.fixture(tmp)
+            sources = T.SourceLedger()
+            sources.add(payload)
+            now = max(T.stat_identity(payload)[k] for k in ("ctime_ns", "mtime_ns")) + T.CacheLedger.RECENT_NS + 1
+            with patch.object(T.time, "time_ns", return_value=now), patch.object(T, "sha256", wraps=T.sha256) as hashes:
+                result = T.CacheLedger(receipt, sources).verify_or_create([payload], {})
+            self.assertEqual(sum(Path(c.args[0]) == payload for c in hashes.call_args_list), 1)
+            self.assertEqual(result["payloads_rehashed_this_run"], 1)
+            self.assertEqual(result["payloads_stat_verified"], 1)
+            self.assertFalse(result["not_fresh_payload_hash"])
+            self.assertEqual(sources.files[str(payload)], T.sha256(payload))
+
+    def test_recent_large_rejected_without_reading_or_accepting_digest(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            payload, receipt = self.fixture(tmp, T.CacheLedger.SMALL_FILE_BYTES + 1)
+            real_hash = T.sha256
+            def no_payload(path, tick=None):
+                self.assertNotEqual(Path(path), payload)
+                return real_hash(path, tick)
+            latest = max(T.stat_identity(payload)[k] for k in ("mtime_ns", "ctime_ns"))
+            for age in (0, T.CacheLedger.RECENT_NS):
+                sources = T.SourceLedger()
+                with patch.object(T.time, "time_ns", return_value=latest + age), patch.object(T, "sha256", side_effect=no_payload):
+                    with self.assertRaisesRegex(ValueError, "recent large"):
+                        T.CacheLedger(receipt, sources).verify_or_create([payload], {})
+                self.assertEqual(sources.files, {})
+
