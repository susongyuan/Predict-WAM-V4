+            result = fit.episode_level(rows([0]) + middle + rows([4]), PARAMS)
+            self.assertEqual(result["on_run_before"], 0)
+        result = fit.episode_level(rows([0, 2, 4], truth="on", prediction="off"), PARAMS)
