+def verify_gpu_authorization(args):
+    """Resource consent only; inline so the existing trainer source receipt covers this gate."""
+    if not getattr(args, "continuation_plan", None) or args.device != "cuda":
+        return None  # CPU and legacy non-continuation behavior is unchanged; no CUDA queries.
+    path = getattr(args, "gpu_authorization", None)
+    expected_sha = getattr(args, "gpu_authorization_sha256", None)
+    if not path or expected_sha != GPU_AUTHORIZATION_SHA256:
+        raise ValueError("CUDA continuation requires explicit --gpu-authorization and pinned --gpu-authorization-sha256")
+    candidate = ROOT / path
+    if candidate.is_symlink() or candidate.resolve() != resolve(GPU_AUTHORIZATION):
+        raise ValueError("GPU authorization must name the pinned actual-user receipt, not a substitute")
+    try:
+        payload = candidate.read_bytes()
+    except OSError as exc:
+        raise ValueError("GPU authorization receipt is missing or unreadable") from exc
+    if hashlib.sha256(payload).hexdigest() != GPU_AUTHORIZATION_SHA256:
+        raise ValueError("GPU authorization receipt SHA256 mismatch")
+    receipt = json.loads(payload)  # Parse precisely the bytes whose digest was checked.
+    expected = {
+        "format": "project2-gpu-peak-authorization-v1",
+        "source": "actual_user_message_in_current_session",
+        "user_text": "允许gpu超过85%的限制，允许达到峰值，我觉得测试和训练应该可以并行吧",
+        "gpu_peak_above_85_percent_allowed": True,
+        "gpu_utilization_percent_allowed": 100,
+        "operational_total_vram_abort_mib": 15300,
+        "cpu_percent_ceiling_unchanged": 85,
+        "ram_percent_ceiling_unchanged": 85,
+        "training_simulation_gpu_concurrency": "not_admitted_without_measured_combined_headroom",
+        "initial_execution_policy": "exclusive GPU lock; serialize simulation and training; CPU analysis may run concurrently",
+    }
+    if not isinstance(receipt, dict) or any(type(receipt.get(k)) is not type(v) or receipt[k] != v
+                                           for k, v in expected.items()):
+        raise ValueError("GPU authorization receipt content differs from actual-user resource consent")
+    return {"path": str(candidate.resolve()), "sha256": GPU_AUTHORIZATION_SHA256, "attestation": receipt}
 
 
